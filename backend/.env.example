# Application
DATABASE_URI=
PORT=5000

# JWT
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUDE_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenRouteService
OPEN_ROUTER_SERVICE_API_KEY=

# Stripe (online payments)
# Secret key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_ / sk_live_)
STRIPE_SECRET_KEY=
# Optional: signing secret of a webhook endpoint pointing to <backend>/api/payment/webhook (starts with whsec_)
STRIPE_WEBHOOK_SECRET=
# Optional: 3-letter currency code, defaults to inr
STRIPE_CURRENCY=inr
# Frontend URL, used as the Stripe return URL fallback (e.g. https://novexa-indol.vercel.app)
CLIENT_URL=
